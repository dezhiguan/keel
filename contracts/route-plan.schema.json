{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.local/contracts/route-plan.schema.json",
  "title": "RoutePlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "mode",
    "partial_policy",
    "reason_code",
    "steps",
    "schema_version",
    "request_id",
    "revision",
    "policy_version",
    "capability_revision",
    "deadline_at",
    "max_attempts",
    "retry_policy"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,160}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "local_fast",
        "local_slow",
        "remote",
        "queue",
        "clarify",
        "deny",
        "approval"
      ]
    },
    "executor": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "partial_policy": {
      "type": "string",
      "enum": [
        "independent_only",
        "require_all"
      ]
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,160}$"
    },
    "steps": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "intent",
          "operation",
          "mode",
          "depends_on",
          "status",
          "input_refs",
          "output_contract",
          "precondition",
          "required_grants",
          "evidence_requirements",
          "timeout_seconds",
          "max_attempts",
          "on_failure"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,160}$"
          },
          "intent": {
            "type": "string",
            "enum": [
              "chat",
              "retrieve_knowledge",
              "retrieve_state",
              "retrieve_history",
              "task_manage",
              "analyze_document",
              "delegate_work",
              "action_request",
              "mixed",
              "unknown"
            ]
          },
          "operation": {
            "type": "string",
            "pattern": "^[a-z][a-z_]{0,47}$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "local_fast",
              "local_slow",
              "remote",
              "queue",
              "clarify",
              "deny",
              "approval"
            ]
          },
          "executor": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,62}$"
          },
          "depends_on": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.:-]{1,160}$"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "running",
              "succeeded",
              "failed",
              "denied",
              "skipped",
              "pending"
            ]
          },
          "reason_code": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,160}$"
          },
          "input_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.:-]{1,160}$"
            },
            "maxItems": 16
          },
          "output_contract": {
            "type": "string",
            "enum": [
              "tool_result",
              "task_receipt",
              "answer",
              "no_action"
            ]
          },
          "precondition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "always",
                  "step_succeeded",
                  "policy_allowed",
                  "never",
                  "unknown"
                ]
              },
              "step_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_.:-]{1,160}$"
              },
              "capability_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_.:-]{1,160}$"
              }
            },
            "required": [
              "kind"
            ]
          },
          "required_grants": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "read_context",
                "task_context"
              ]
            },
            "maxItems": 16
          },
          "approval_ref": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,160}$"
          },
          "evidence_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "tool_result",
                "durable_receipt",
                "citations"
              ]
            },
            "maxItems": 16
          },
          "budget_cap_cny": {
            "type": "number",
            "minimum": 0
          },
          "timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 120
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1
          },
          "on_failure": {
            "type": "string",
            "enum": [
              "abort",
              "skip",
              "clarify"
            ]
          }
        }
      }
    },
    "schema_version": {
      "type": "string",
      "const": "keel/v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,160}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,160}$"
    },
    "capability_revision": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,160}$"
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "retry_policy": {
      "type": "string",
      "enum": [
        "never",
        "query_only"
      ]
    },
    "budget_cap_cny": {
      "type": "number",
      "minimum": 0
    },
    "parent_task_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,160}$"
    },
    "parent_run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,160}$"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^[a-f0-9]{2}-[a-f0-9]{32}-[a-f0-9]{16}-[a-f0-9]{2}$"
    },
    "executor_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,160}$"
        },
        "env": {
          "type": "string",
          "enum": [
            "staging",
            "prod"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,160}$"
        },
        "capability_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,160}$"
        }
      },
      "required": [
        "agent_id",
        "env",
        "version",
        "capability_id"
      ]
    }
  }
}
