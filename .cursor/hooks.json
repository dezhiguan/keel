{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "python3 .cursor/hooks/forbidden-patterns.py",
        "timeout": 15,
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/scoped-test.py",
        "timeout": 600,
        "failClosed": false,
        "loop_limit": 2
      }
    ]
  }
}
