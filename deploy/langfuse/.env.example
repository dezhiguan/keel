# 复制为 .env 后填写。不要把 .env 提交进 git。
# 官方 headless 一次只创建下面这一个项目。dev / staging / prod 不能靠重复这组变量建出来。
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
AUTH_DISABLE_SIGNUP=true
TELEMETRY_ENABLED=false
LANGFUSE_INIT_ORG_ID=keel
LANGFUSE_INIT_ORG_NAME=Keel
LANGFUSE_INIT_PROJECT_ID=keel-dev
LANGFUSE_INIT_PROJECT_NAME=keel-dev
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=Keel Admin
LANGFUSE_INIT_USER_PASSWORD=
